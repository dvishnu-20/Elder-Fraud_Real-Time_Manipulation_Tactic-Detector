# Phase 7 Configuration
# Copy to .env and adjust as needed

# Application Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Frozen Model Paths (Phase 5/6 validated — DO NOT CHANGE without experiment)
DISTILBERT_PATH=ml/models/tactic_classifier/v2_temporal_validity/
LSTM_PATH=ml/models/temporal_risk/lstm_v2/

# Frozen LSTM Decision Threshold (tau = 0.20)
LSTM_DECISION_THRESHOLD=0.20

# ASR Provider: mock, replay, whisper_local
ASR_PROVIDER=mock
ASR_SAMPLE_RATE=16000

# Privacy Settings
STORE_AUDIO=false
STORE_TRANSCRIPT=true
REDACT_PII=true

# Model Integrity
VERIFY_CHECKSUMS=true

# External ASR API Key (if using external provider)
# ASR_API_KEY=your_key_here
# NEVER commit real credentials
